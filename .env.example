# Supabase — lấy từ https://supabase.com/dashboard/project/<project-id>/settings/api
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_URL="https://<project-id>.supabase.co"

# GEMINI_API_KEY chỉ đặt trong Supabase Edge Functions Secrets, không đặt ở đây.
# Server secrets: GEMINI_MODEL (tùy chọn), ALLOWED_ORIGINS (các origin phân cách bằng dấu phẩy).
